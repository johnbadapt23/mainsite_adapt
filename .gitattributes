# Normalize line endings for text files so the repo is consistent regardless
# of whether it's checked out/edited on Windows or Linux/Mac. Git stores LF
# in the repository and converts to the platform's native line ending on
# checkout for anyone with core.autocrlf configured.
* text=auto

# Explicitly binary -- never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.pdf binary
